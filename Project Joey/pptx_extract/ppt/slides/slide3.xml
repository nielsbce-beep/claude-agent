one/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Meting &amp; Berekening</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="§"/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Visuele schatting:</a:t></a:r><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t> ± 3,70 meter.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="§"/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Telling &amp; berekening:</a:t></a:r><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t> 24 treden x 15 cm = 3,60 meter.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="Tekstvak 10"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{56AA50B2-1FDF-57A7-C2AE-7B39DC0CB253}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="7803744" y="5482571"/><a:ext cx="4506535" cy="3046988"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Toelichting Profieldoorsnede</a:t></a:r></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:endParaRPr lang="nl-NL" sz="1600" b="1"/></a:p><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t>In de getekende profieldoorsnede is de situatie van links naar rechts opgemeten:</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="§"/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Links:</a:t></a:r><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t> Bebouwing en het trottoir (8,2m in totaal)  richting het water.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="§"/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Midden:</a:t></a:r><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t> De Ringvaart met een breedte van circa 20 meter.</a:t></a:r></a:p><a:p><a:pPr marL="285750" indent="-285750"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="§"/></a:pPr><a:r><a:rPr lang="nl-NL" sz="1600" b="1"/><a:t>Rechts:</a:t></a:r><a:r><a:rPr lang="nl-NL" sz="1600"/><a:t> De dijk met een schatting van de hoogte van 3,7 meter, met onderaan de straat (4 m), het trottoir (3,6 m) en eigen terrein van (2,4 m) de aansluitende bebouwing.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Tekstvak 11"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{EB6A71B0-C9A1-62F2-D7F6-0F28856C8044}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="268515" y="4921415"/><a:ext cx="6052457" cy="369332"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:buNone/></a:pPr><a:r><a:rPr lang="nl-NL" b="1"/><a:t>Doorsnede: </a:t></a:r><a:endParaRPr lang="nl-NL"/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="14" name="Afbeelding 13"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{61BE7181-D020-B6B8-C978-072CC220A235}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId3"/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="326928" y="5175523"/>