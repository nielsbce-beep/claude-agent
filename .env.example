# =============================================================
# WK 2026 Video Agent — omgevingsvariabelen
# Kopieer dit bestand naar .env en vul je eigen keys in.
# NOOIT het .env bestand committen naar git.
# =============================================================

# ── Groq (AI scriptgeneratie) ─────────────────────────────────────────────────
# Gratis account: console.groq.com → "Create API Key"
# Gebruikt model: llama-3.3-70b-versatile (gratis)
GROQ_API_KEY=jouw_groq_key_hier

# ── API-Football (wedstrijddata, standen, uitslagen) ──────────────────────────
# Gratis: 100 calls/dag
# Aanmelden: https://dashboard.api-football.com/register
# Na registratie: Dashboard → "My Access" → kopieer de API Key
FOOTBALL_API_KEY=jouw_api_football_key_hier

# ── The Odds API (bookmaker kansen) ──────────────────────────────────────────
# Gratis: 500 calls/maand
# Aanmelden: https://the-odds-api.com/#get-access → "Get API Key"
# Na registratie: direct zichtbaar op de homepage wanneer ingelogd
ODDS_API_KEY=jouw_odds_api_key_hier
