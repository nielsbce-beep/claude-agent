# ── Anthropic (required) ────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── iCloud Calendar (optional — skip if you don't use iCloud) ───────────────────
# Use an app-specific password, NOT your iCloud password.
# Generate one at: https://appleid.apple.com → Security → App-Specific Passwords
ICLOUD_USERNAME=your@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Whoop (optional — skip if you don't have a Whoop) ──────────────────────────
# Register a developer app at: https://developer.whoop.com/
WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret
WHOOP_REDIRECT_URI=http://localhost:8080/callback
